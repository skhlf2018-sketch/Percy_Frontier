[resource]
script = ExtResource("2_data")
id = &"mire_maw"
display_name = "늪턱 구렁"
family = "파충류"
threat_tier = 4
combat_role = "보스"
description = "남서쪽 늪 깊은 구렁에 사는 포식자. 악어의 머리와 뱀의 긴 몸을 가졌다. 가까이서는 턱을 내리꽂고, 옆이나 뒤로 돌면 꼬리로 휩쓸고, 멀리 있으면 크게 뛰어들어 문다. 뛰어들다 돌기둥에 부딪히면 한참 정신을 잃는다. 다치면 진흙 속으로 숨어 발밑에서 솟구치고, 크게 다치면 몸을 굴리며 돌진한다. 목 아래의 붉은 턱살이 약점이다."
